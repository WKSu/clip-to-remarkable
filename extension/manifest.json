{
  "manifest_version": 3,
  "name": "Clip to reMarkable",
  "version": "0.1.2",
  "description": "Extract the current article with Readability, bundle its images, and build a clean EPUB.",
  "browser_specific_settings": {
    "gecko": {
      "id": "clip-to-remarkable@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "rmapi-bundle.js",
      "epub-builder.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Clip this article to EPUB and Remarkable"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}